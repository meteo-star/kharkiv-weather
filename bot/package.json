{
  "name": "meteo-star-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram-бот для Meteo Star — push-уведомления по правилам погоды через Cloudflare Worker",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "set-webhook": "node scripts/set-webhook.js",
    "secrets:token": "wrangler secret put TELEGRAM_BOT_TOKEN",
    "secrets:webhook": "wrangler secret put TELEGRAM_WEBHOOK_SECRET"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
